<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focado -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#64B5F6"
                android:endColor="#1E88E5"
                android:angle="45"/>
            <corners android:radius="40dp"/>
            <stroke android:width="3dp" android:color="#0D47A1"/>
            <padding android:left="20dp" android:top="18dp"
                android:right="20dp" android:bottom="18dp"/>
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <stroke android:width="2dp" android:color="#90CAF9"/>
            <corners android:radius="40dp"/>
            <padding android:left="20dp" android:top="18dp"
                android:right="20dp" android:bottom="18dp"/>
            <shadowColor android:color="#33000000"/>
        </shape>
    </item>

</selector>
